{
    "compilerOptions": {
        "target": "es5",
        "module": "commonjs",
        "strict": true,
        "declaration": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["dom", "es2015"]
    },
    "include": ["src/**/*"],
    "exclude": ["docs", "node_modules", "**/*.test.ts"]
}